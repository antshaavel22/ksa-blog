# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local

# local Claude Code config
.claude/

# script state files
.fill-translations-progress.json
.scout-seen.json

# macOS/iCloud sync conflict copies. This repo lives under ~/Desktop, which is
# synced, so rapid batch writes (e.g. regenerating hundreds of excerpts) make
# iCloud drop "<name> 2.mdx" duplicates beside the originals. 95 of these
# appeared during one excerpt run and a few had previously been committed by a
# careless `git add`. Never commit them — the originals are the real files.
* 2.*
* 3.*
